# ==============================================================================
# Remix MaskedD - API Key & Secrets Configuration
# Rename or copy this file to `.env` or `local.properties` in the root folder.
# Multiple keys should be comma-separated. The app will automatically rotate
# through keys when rate limits (HTTP 429) or quota errors occur.
# ==============================================================================

# Fish.audio API Keys (Comma-separated for auto-rotation)
FISH_AUDIO_API_KEYS="your_fish_audio_key_1,your_fish_audio_key_2,your_fish_audio_key_3"

# ElevenLabs API Keys (Comma-separated for auto-rotation)
ELEVENLABS_API_KEYS="sk_eleven_key_1,sk_eleven_key_2,sk_eleven_key_3"

# Google Gemini API Keys (Comma-separated for Socratic AI, quiz, & prosody analysis)
GEMINI_API_KEYS="AIzaSy_key_1,AIzaSy_key_2,AIzaSy_key_3"

# Open-Source FireRedTTS-2 / LongCat-AudioDiT API Keys (Optional)
FIRERED_API_KEY="firered_key_1"
LONGCAT_API_KEY="longcat_key_1"

# Remote OTA Self-Update Config URL (Optional - defaults to GitHub version.json)
REMOTE_VERSION_CHECK_URL="https://raw.githubusercontent.com/mdtbmw/maskedd/main/version.json"
